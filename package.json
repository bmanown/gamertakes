{
  "name": "gamertakes",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "db:push": "pnpm --filter @gamertakes/db db:push",
    "db:studio": "pnpm --filter @gamertakes/db db:studio",
    "db:migrate": "pnpm --filter @gamertakes/db db:migrate"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.4.0",
    "prettier": "^3.2.0",
    "eslint": "^9.0.0"
  }
}
